# Neon Postgres — pooled connection used by the app at runtime
# (Neon driver adapter / WebSocket endpoint, ends with "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon Postgres — direct (non-pooled) connection used by the Prisma CLI
# for migrate / generate / studio.
#
# IMPORTANT: strip "&channel_binding=require" from the string Neon gives you.
# Prisma's schema engine doesn't support SCRAM channel binding and fails with
# a misleading "P1001: Can't reach database server" even though the host is
# reachable. Only DIRECT_URL is affected — DATABASE_URL goes through the Neon
# driver adapter, which supports it.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require"
